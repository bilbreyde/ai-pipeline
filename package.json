{
  "name": "zones-ai-pipeline",
  "version": "0.1.0",
  "private": true,
  "description": "Shared AI practice pipeline tracker. Azure Functions API and static UI, Cosmos DB storage.",
  "type": "module",
  "main": "src/functions/*.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "func start",
    "dev": "node dev/server.mjs",
    "test": "node --test \"test/**/*.test.mjs\"",
