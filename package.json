    "import": "node scripts/import-from-excel.mjs"
  },
  "dependencies": {
    "@azure/cosmos": "^4.10.1",
    "@azure/functions": "^4.16.5",
    "@azure/identity": "^4.13.3",
    "exceljs": "^4.4.0"
  }
}
